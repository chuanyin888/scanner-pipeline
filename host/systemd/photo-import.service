[Unit]
Description=Photo Import HTTP server (phone upload -> data/<date>/<region>/)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/scanner
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/scanner/photo_import.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
