[Unit]
Description=Automated High-Speed Inventory Scanner
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/scanner
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/scanner/scanner_daemon.py
Restart=always
RestartSec=3
Nice=-5

[Install]
WantedBy=multi-user.target
